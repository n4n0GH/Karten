<component type="desktop-application">
  <id>io.github.n4n0gh.karten</id>
  <name>Karten</name>
  <summary>Maps and route planning that also work offline</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer id="io.github.n4n0gh">
    <name>Karten contributors</name>
